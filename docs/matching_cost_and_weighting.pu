@startuml matching_cost_and_weighting
!theme plain
skinparam defaultTextAlignment left
skinparam ActivityBorderColor #0055BB
skinparam ActivityBackgroundColor #F0F8FF

title 3D & 2D LiDAR Independent Residual Matching Cost Process

start

:Receive 3D LiDAR obstacles (N_3D points)
and 2D LiDAR obstacles (N_2D points);

partition "1. Effective 2D Weight Determination" {
  if (N_2D >= min_2d_points AND N_3D >= min_3d_points) then (Both Available)
    :Calculate Field-of-View Ratio:
    fov_scale = min(1.0, N_2D / target_2d_points);
    :Scale Configured Weight:
    w_2D = weight_2d_lidar * fov_scale;
  elseif (N_2D >= min_2d_points AND N_3D < min_3d_points) then (3D Occluded / Degraded)
    :Fallback Entirely to 2D LiDAR:
    w_2D = 1.0;
  else (2D Not Reliable / Sparse)
    :Disable 2D Weight:
    w_2D = 0.0;
  endif
}

partition "2. Independent Residual Cost Evaluation" {
  :Compute Normalized 3D Residual Cost:
  C_3D = (1 / N_3D) * Σ min( ESDF( T * p_3D,i ), max_dist_thresh );

  if (w_2D > 0.0) then (Evaluate 2D)
    :Compute Normalized 2D Residual Cost:
    C_2D = (1 / N_2D) * Σ min( ESDF( T * p_2D,j ), max_dist_thresh );
  else (Skip 2D)
    :C_2D = 0.0;
  endif

  :Synthesize Composite Cost:
  C_total = (1.0 - w_2D) * C_3D + w_2D * C_2D;
}

partition "3. Inlier Verification & Convergence Check" {
  :Count Inliers:
  N_inlier = count of points with ESDF( T * p ) <= inlier_dist_thresh;
  :Compute Average Inlier Cost:
  C_inlier = (1 / N_inlier) * Σ ESDF( T * p );

  if (C_total < cost_threshold) then (Accepted by Composite Cost)
    :Mark Localization Succeeded;
    :Update Position & Reset lost_frame_count = 0;
  elseif (N_inlier >= min_inliers AND C_inlier < inlier_cost_thresh) then (Accepted by Inlier Criteria)
    :Mark Localization Succeeded;
    :Update Position & Reset lost_frame_count = 0;
  else (Rejected)
    :Increment lost_frame_count;
    if (lost_frame_count >= lost_count_thresh) then (Lost Limit Exceeded)
      :Trigger Global Recovery Search (Yaw-Constrained);
    else (Transient Drop)
      :Dead Reckoning with IMU & Velocity Extrapolation;
    endif
  endif
}

stop

@enduml
